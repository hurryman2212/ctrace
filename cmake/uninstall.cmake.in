set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "No install manifest: ${manifest}")
endif()

file(STRINGS "${manifest}" CMAKE_INSTALL_MANIFEST_FILES)
foreach(installed_file IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
  set(path "$ENV{DESTDIR}${installed_file}")
  if(IS_DIRECTORY "${path}" AND NOT IS_SYMLINK "${path}")
    message(FATAL_ERROR "Refusing to remove a directory: ${path}")
  endif()
  if(EXISTS "${path}" OR IS_SYMLINK "${path}")
    message(STATUS "Uninstalling: ${path}")
    file(REMOVE "${path}")
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "Could not remove: ${path}")
    endif()
  endif()
endforeach()
include("@CMAKE_CURRENT_BINARY_DIR@/ldconfig.cmake")
