#!/usr/bin/env python3
"""Run the CMake-built C/C++ tracer."""

import argparse, fcntl, os, platform, pwd, re, shutil, socket, stat, struct, subprocess, sys

from pathlib import Path


class TraceError(Exception):
    pass


class HelpFormatter(argparse.RawDescriptionHelpFormatter):
    def _split_lines(self, text, width):
        lines = []
        for paragraph in text.splitlines():
            lines.extend(super()._split_lines(paragraph, width))
        return lines


def install_prefixes(value):
    paths = value.split(",")
    if any(not path or any(c in path for c in "\r\n\0") for path in paths):
        raise argparse.ArgumentTypeError("--install-prefix requires PATH,...")
    return [Path(path).expanduser().resolve() for path in paths]


def cache_directory(value=None):
    if value == "":
        return ""
    if value is not None:
        if any(c in value for c in "\r\n\0"):
            raise argparse.ArgumentTypeError(
                "--cache-dir requires a valid PATH or an empty string"
            )
        return str(Path(value).expanduser().resolve())
    directory = os.environ.get("XDG_CACHE_HOME")
    if directory and Path(directory).is_absolute():
        return str((Path(directory) / "ctrace").resolve())
    return str((Path.home() / ".cache/ctrace").resolve())


def source_map(value):
    mappings = {}
    for pair in value.split(","):
        old, separator, new = pair.partition("=")
        new = os.path.expanduser(new)
        if not separator or not old.startswith("/") or not new.startswith("/"):
            raise argparse.ArgumentTypeError(
                "--src-map requires absolute OLD=NEW prefixes"
            )
        old, new = os.path.normpath(old), os.path.normpath(new)
        if old in mappings or any(c in pair for c in "\r\n\0"):
            raise argparse.ArgumentTypeError("invalid or duplicate --src-map prefix")
        mappings[old] = new
    return ",".join(f"{old}={new}" for old, new in mappings.items())


def argument_parser():
    parser = argparse.ArgumentParser(
        prog="ctrace",
        add_help=False,
        allow_abbrev=False,
        formatter_class=HelpFormatter,
        usage=(
            "%(prog)s [--cache-dir PATH] [--decompile] [-f] "
            "[-h] [--init-instrument {arm,perfetto,full}] [--install-prefix PATH,...] "
            "[--kernel-sign-key FILE --kernel-sign-cert FILE] [--kernel-sign-hash HASH] "
            "[--no-style] [-o FILE] [--perfetto] [--perfetto-only] [--skip-src-checksum] "
            "[--src-map OLD=NEW,...] "
            "[--x86-syntax {att,intel}] "
            "[--recurse-step-into PATTERN,...] "
            "[--step-into PATTERN,...] [--step-over PATTERN,...] "
            "[--within PATTERN,...] [--within-init] [--within-intr] "
            "[--within-new-stack] PROG [ARGS]"
        ),
        description="Trace C/C++ execution or a kernel module and observed before/after values.",
    )
    parser.add_argument(
        "--cache-dir",
        type=cache_directory,
        default=None,
        metavar="PATH",
        help=(
            'Disk cache root; "" disables all disk caches (default: '
            "XDG_CACHE_HOME/ctrace, then ~/.cache/ctrace)"
        ),
    )
    parser.add_argument(
        "--decompile",
        action="store_true",
        help=(
            "Use Ghidra to reconstruct statements when verified source is unavailable "
            "(see --install-prefix for engine discovery)"
        ),
    )
    parser.add_argument(
        "-f",
        "--follow-forks",
        action="store_true",
        help=(
            "Follow newly created child threads and processes; exec from a traced "
            "thread is always followed, with or without -f"
        ),
    )
    parser.add_argument(
        "-h", "--help", action="help", help="Show this help message and exit"
    )
    parser.add_argument(
        "--init-instrument",
        choices=("arm", "perfetto", "full"),
        default="full",
        help="Initial instrumentation level (default: full)",
