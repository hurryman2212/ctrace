            "bar remain visible regardless of filters.\n"
            "Output: PROGRAM.HOSTNAME.USERNAME.YYYYMMDD-HHMMSS.TID.json in the current "
            "working directory (shared wall-clock timeline across threads and processes; "
            "slice costs separately exclude tracing callbacks and terminal output). "
            "The filename uses local time when the logger creates the file and the "
            "initial traced thread's TID"
        ),
    )
    parser.add_argument(
        "--perfetto-only",
        action="store_true",
        help="Suppress ctrace trace logs; keep warnings (requires --perfetto)",
