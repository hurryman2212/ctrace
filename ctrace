        ),
    )
    kernel.add_argument(
        "--kernel-sign-key",
        type=Path,
        metavar="FILE",
        help="Re-sign transformed signed input with this private key (requires --kernel-sign-cert)",
    )
    kernel.add_argument(
        "--kernel-sign-cert",
        type=Path,
        metavar="FILE",
        help="Signing certificate (requires --kernel-sign-key)",
    )
    kernel.add_argument(
        "--kernel-sign-hash",
        metavar="HASH",
        help=(
            "Optional hash override (requires signing key). Otherwise try compatible "
            "hashes in order: original module, kernel default, sha256, remaining hashes"
        ),
    )
    parser.add_argument(
        "-o",
        "--output",
        metavar="FILE",
        help="Write all ctrace logs to FILE; target stdout/stderr stay unchanged",
    )
    parser.add_argument(
        "--perfetto",
        action="store_true",
        help=(
            "Write Perfetto function/block events selected by within selectors "
            "and step filters. Step-over calls hide body events.\n"
            "Syscalls are recorded while --within is active or in signal handlers, "
